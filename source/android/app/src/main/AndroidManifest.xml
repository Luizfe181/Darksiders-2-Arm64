<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- minSdk 26 e targetSdk 31 vem do build.gradle; declara-los aqui tambem
         faz o AGP avisar sobre conflito. -->

    <!-- Leitura dos assets (media.upak) e dos drivers Vulkan customizados. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Android 11+: necessario para ler /sdcard/Darksiders2 e /sdcard/Download.
         Tem de ser pedida ao utilizador em runtime (Settings > All files access). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Vulkan 1.1 (level 1). A versao hexadecimal do `vulkan.version` e
         aceite de forma inconsistente pelo aapt; o `level` e inequivoco. -->
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1"
        android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:hasCode="true"
        android:hardwareAccelerated="true">

        <!-- Tela de configuracao: escolhe a pasta do jogo e o driver Turnip,
             grava o config.ini e so depois inicia o jogo. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|density"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Browser de pastas: devolve um caminho real para o codigo nativo. -->
        <activity
            android:name=".FolderPickerActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|density"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- O jogo (SDL). Iniciado apenas pela tela de configuracao. -->
        <activity
            android:name=".Darksiders2Activity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|density"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
    </application>
</manifest>
