<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="#E8C15A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/setup_subtitle"
            android:textColor="#9AA0A6"
            android:textSize="14sp" />

        <!-- Pasta do jogo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/setup_game_folder"
            android:textColor="#E6E6E6"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pathText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/setup_no_folder"
            android:textColor="#8AB4F8"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/pathStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#9AA0A6"
            android:textSize="13sp" />

        <Button
            android:id="@+id/pickFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/setup_pick_folder" />

        <!-- Driver Vulkan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/setup_driver"
            android:textColor="#E6E6E6"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/driverText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/setup_driver_system"
            android:textColor="#8AB4F8"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/driverStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#9AA0A6"
            android:textSize="13sp" />

        <Button
            android:id="@+id/pickDriver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/setup_pick_driver" />

        <Button
            android:id="@+id/clearDriver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_clear_driver" />

        <!-- Estado geral -->
        <TextView
            android:id="@+id/overall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#F28B82"
            android:textSize="13sp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:enabled="false"
            android:text="@string/setup_start"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
