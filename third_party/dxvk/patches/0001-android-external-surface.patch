@@ -11,7 +11,12 @@ namespace dxvk {
 
   DxvkNameSet DxvkPlatformExts::getInstanceExtensions() {
     DxvkNameSet names;
+#ifdef __ANDROID__
+    // The surface is the host's, so only the generic extension is required.
+    names.add(VK_KHR_SURFACE_EXTENSION_NAME);
+#else
     names.add(VK_KHR_WIN32_SURFACE_EXTENSION_NAME);
+#endif
 
     return names;
   }
diff --git a/src/vulkan/vulkan_presenter.cpp b/src/vulkan/vulkan_presenter.cpp
index b02869e..8432ddf 100644
--- a/src/vulkan/vulkan_presenter.cpp
+++ b/src/vulkan/vulkan_presenter.cpp
@@ -4,6 +4,18 @@
 
 namespace dxvk::vk {
 
+#ifdef __ANDROID__
+  // ANDROID PORT: created by the platform layer (SDL2), which owns it. The host
+  // calls dxvk_android_set_surface() right after loading this library, before
+  // any device is created.
+  static VkSurfaceKHR g_androidSurface = VK_NULL_HANDLE;
+
+  extern "C" __attribute__((visibility("default")))
+  void dxvk_android_set_surface(VkSurfaceKHR surface) {
+    g_androidSurface = surface;
+  }
+#endif
+
   Presenter::Presenter(
           HWND            window,
     const Rc<InstanceFn>& vki,
@@ -445,6 +457,24 @@ namespace dxvk::vk {
 
 
   VkResult Presenter::createSurface() {
+#ifdef __ANDROID__
+    // The host already has a surface for its window: there is no HWND and no
+    // Win32 surface extension on Android.
+    if (g_androidSurface != VK_NULL_HANDLE) {
+      m_surface     = g_androidSurface;
+      m_ownsSurface = false;
+
+      VkBool32 supported = VK_FALSE;
+      VkResult status = m_vki->vkGetPhysicalDeviceSurfaceSupportKHR(
+        m_device.adapter, m_device.queueFamily, m_surface, &supported);
+
+      if (status != VK_SUCCESS)
+        return status;
+
+      return supported ? VK_SUCCESS : VK_ERROR_OUT_OF_HOST_MEMORY;
+    }
+#endif
+
     HINSTANCE instance = reinterpret_cast<HINSTANCE>(
       GetWindowLongPtr(m_window, GWLP_HINSTANCE));
     
@@ -495,6 +525,12 @@ namespace dxvk::vk {
 
 
   void Presenter::destroySurface() {
+#ifdef __ANDROID__
+    if (!m_ownsSurface) {
+      m_surface = VK_NULL_HANDLE;
+      return;
+    }
+#endif
     m_vki->vkDestroySurfaceKHR(m_vki->instance(), m_surface, nullptr);
   }
 
